# Environment variables for RunViz
# Copy this file to .env and fill in your values

# Cloudflare Workers API URL (your deployed worker)
VITE_API_URL=https://your-worker.your-subdomain.workers.dev

# Optional base path if you are not serving the app from /
# For Cloudflare Pages, leave this unset unless you deliberately deploy under a subpath.
# VITE_BASE_PATH=/

# Optional Logo.dev publishable token (for shoe brand logos)
# If omitted, the app falls back to emoji badges.
# VITE_LOGO_DEV_TOKEN=pk_xxxxxxxxxxxxxxxxx

# Optional: Override redirect URI (usually auto-detected)
# VITE_STRAVA_REDIRECT_URI=https://your-project.pages.dev/callback
